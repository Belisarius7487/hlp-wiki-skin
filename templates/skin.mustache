{{!
	HLP Fire skin template (SkinMustache).
	Uses only the standard data keys MediaWiki provides to every Mustache skin.
}}
<script>
/* Apply the saved colour scheme before first paint to avoid a flash. */
document.documentElement.classList.add( 'hlp-js' );
try { if ( localStorage.getItem( 'hlp-wiki-scheme' ) === 'void' ) { document.documentElement.classList.add( 'hlp-void' ); } } catch ( e ) {}
try { if ( localStorage.getItem( 'hlp-wiki-layout' ) === 'wide' ) { document.documentElement.classList.add( 'hlp-wide' ); } } catch ( e ) {}
</script>
<div class="hlp-page">
	<header class="hlp-header">
		<div class="hlp-header-inner">
			<a class="hlp-brand" href="{{link-mainpage}}">
				<span class="mw-wiki-logo hlp-logo"></span>
				<span class="hlp-sitename">FreeSpace Wiki</span>
			</a>
			<nav class="hlp-nav" aria-label="{{msg-hlpfire-nav-label}}">
				{{#data-portlets-sidebar.data-portlets-first}}<ul>{{{html-items}}}</ul>{{/data-portlets-sidebar.data-portlets-first}}
				<details class="hlp-menu">
					<summary>{{msg-hlpfire-menu-tools}}</summary>
					<div class="hlp-menu-panel">
						{{#data-portlets-sidebar.array-portlets-rest}}
						<div class="hlp-portlet"><h3>{{label}}</h3><ul>{{{html-items}}}</ul></div>
						{{/data-portlets-sidebar.array-portlets-rest}}
					</div>
				</details>
			</nav>
			{{#data-search-box}}
			<form class="hlp-search" role="search" action="{{form-action}}" id="searchform">
				<input type="hidden" value="{{page-title}}" name="title">
				{{{html-input}}}{{{html-button-search}}} {{{html-button-search-fallback}}}
			</form>
			{{/data-search-box}}
			<button type="button" id="hlp-scheme-switch" title="{{msg-hlpfire-scheme-switch-tooltip}}">{{msg-hlpfire-scheme-fire}}</button>
			<button type="button" id="hlp-layout-switch" title="{{msg-hlpfire-layout-switch-tooltip}}">{{msg-hlpfire-layout-normal}}</button>
			{{#data-portlets}}{{#data-personal}}
			<div class="hlp-personal"><ul>{{{html-items}}}</ul></div>
			{{/data-personal}}{{/data-portlets}}
		</div>
	</header>

	<div class="hlp-wrap">
		<main class="hlp-main mw-body" id="content" role="main">
			{{#html-site-notice}}<div id="siteNotice">{{{.}}}</div>{{/html-site-notice}}
			<div class="hlp-titlerow">
				{{{html-title-heading}}}
				{{#data-portlets}}
				<div class="hlp-tabs">
					<ul>{{{data-namespaces.html-items}}}{{{data-views.html-items}}}</ul>
					<details class="hlp-menu hlp-actions">
						<summary>{{msg-hlpfire-menu-more}}</summary>
						<div class="hlp-menu-panel"><ul>{{{data-actions.html-items}}}{{{data-variants.html-items}}}</ul></div>
					</details>
				</div>
				{{/data-portlets}}
			</div>
			<div class="mw-indicators">
				{{#array-indicators}}<div id="{{id}}" class="{{class}}">{{{html}}}</div>{{/array-indicators}}
			</div>
			<div id="bodyContent" class="hlp-body">
				<div id="contentSub" {{{html-user-language-attributes}}}>{{{html-subtitle}}}</div>
				{{#html-undelete-link}}<div id="contentSub2">{{{.}}}</div>{{/html-undelete-link}}
				{{{html-user-message}}}
				{{{html-body-content}}}
				{{{html-categories}}}
			</div>
			{{{html-after-content}}}
		</main>
		{{! Filled by main.js: the table of contents is moved here when the page has one. }}
		<aside class="hlp-aside" id="hlp-aside" hidden></aside>
	</div>

	<footer class="hlp-footer" role="contentinfo" {{{html-user-language-attributes}}}>
		{{#data-footer}}
		{{#data-icons}}
		{{#array-items}}<div class="hlp-footer-icon">{{{html}}}</div>{{/array-items}}
		{{/data-icons}}
		<ul>
			{{#data-info}}{{#array-items}}<li>{{{html}}}</li>{{/array-items}}{{/data-info}}{{#data-places}}{{#array-items}}<li>{{{html}}}</li>{{/array-items}}{{/data-places}}
		</ul>
		{{/data-footer}}
	</footer>
</div>
